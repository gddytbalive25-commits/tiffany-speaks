# Database connection for persistent guest sessions and Stripe entitlements.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/tiffany_speaks

# Managed Stripe integration supplies STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET.
# Keep test Price IDs here until the owner explicitly prepares live pricing.
STRIPE_ONE_TIME_PRICE_ID=price_replace_with_test_one_time_price
STRIPE_SUBSCRIPTION_PRICE_ID=price_replace_with_test_subscription_price

# Exact browser-visible application origin; local APP_URL opts into HTTP/Lax cookies.
APP_URL=http://localhost:3000
